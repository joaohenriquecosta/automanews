# ==============================================================================
# DATABASE CONFIGURATION (Infrastructure Layer)
# Used by `infra/db.js` and `local_postgres` container
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==============================================================================
# EMAIL SMTP AND HTTP CONFIGURATION (Infrastructure Layer)
# Used by `infra/mailer.js`
# ==============================================================================
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=1080

# ==============================================================================
# TEST EXPECTATIONS (Integration Layer)
# Used by `tests/integration/api/v1/status/get.test.js`
# Served to Jest via `dotenv -e .env.development` in `package.json` scripts
# ==============================================================================
POSTGRES_VERSION='16.0'
POSTGRES_MAX_CONNECTIONS=100
