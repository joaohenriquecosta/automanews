# ==============================================================================
# DATABASE CONFIGURATION (Infrastructure Layer)
# Used by `infra/db.js` and `local_postgres` container
# ==============================================================================
PGHOST=localhost
PGPORT=5432
PGUSER=local_user
PGDATABASE=local_db
PGPASSWORD=local_password

# ==============================================================================
# TEST EXPECTATIONS (Integration Layer)
# Used by `tests/integration/api/v1/status/get.test.js`
# Served to Jest via `dotenv -e .env.development` in `package.json` scripts
# ==============================================================================
POSTGRES_VERSION='16.0'
POSTGRES_MAX_CONNECTIONS=100