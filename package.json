{
  "name": "automanews.com.br",
  "version": "1.0.0",
  "description": "**AutomaNews** is a collaborative content platform focused on **home automation** and **smart home technologies**.   Inspired by [TabNews](https://www.tabnews.com.br/), the project brings together **news, tutorials, reviews, and community discussions** around the world of connected homes.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up &&  npm run wait-for-postgres && npm run migration:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "next lint --dir .",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "npm run services:up &&  npm run wait-for-postgres && jest --watchAll --runInBand",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate --envPath .env.development -m infra/migrations up",
    "migration:down": "node-pg-migrate --envPath .env.development -m infra/migrations down",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "joaohenriquecosta <joaohenrique_costa@icloud.com> (https://automanews.com.br)",
  "license": "MIT",
  "keywords": [
    "home automation",
    "casa inteligente",
    "automação residencial",
    "smart home",
    "IoT",
    "hub",
    "wifi",
    "tutorial",
    "reviews",
    "comunidade",
    "zigbee",
    "ha",
    "home assistant"
  ],
  "homepage": "https://github.com/joaohenriquecosta/automanews.com.br#readme",
  "bugs": {
    "url": "https://github.com/joaohenriquecosta/automanews.com.br/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaohenriquecosta/automanews.com.br.git"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "16.4.5",
    "dotenv-cli": "11.0.0",
    "next": "14.2.5",
    "node-pg-migrate": "7.6.1",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.0",
    "@commitlint/config-conventional": "19.2.2",
    "commitizen": "4.3.1",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.8.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.6.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
