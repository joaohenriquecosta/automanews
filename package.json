{
  "name": "automanews.com.br",
  "version": "1.0.0",
  "description": "**AutomaNews** is a collaborative content platform focused on **home automation** and **smart home technologies**.   Inspired by [TabNews](https://www.tabnews.com.br/), the project brings together **news, tutorials, reviews, and community discussions** around the world of connected homes.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml --env-file .env.development up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "dotenv -e .env.development -- jest",
    "test:watch": "dotenv -e .env.development -- jest --watchAll",
    "migration:create": "dotenv -e .env.development -- node-pg-migrate -m infra/migrations create",
    "migration:up": "dotenv -e .env.development -- node-pg-migrate -m infra/migrations up",
    "migration:down": "dotenv -e .env.development -- node-pg-migrate -m infra/migrations down"
  },
  "author": "joaohenriquecosta <joaohenrique_costa@icloud.com> (https://automanews.com.br)",
  "license": "MIT",
  "keywords": [
    "home automation",
    "casa inteligente",
    "automação residencial",
    "smart home",
    "IoT",
    "hub",
    "wifi",
    "tutorial",
    "reviews",
    "comunidade",
    "zigbee",
    "ha",
    "home assistant"
  ],
  "homepage": "https://github.com/joaohenriquecosta/automanews.com.br#readme",
  "bugs": {
    "url": "https://github.com/joaohenriquecosta/automanews.com.br/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaohenriquecosta/automanews.com.br.git"
  },
  "dependencies": {
    "dotenv": "^16.4.4",
    "next": "^13.1.6",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^29.6.2",
    "prettier": "^3.6.2"
  }
}