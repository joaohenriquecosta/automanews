{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint*)",
      "Bash(npm run migrations*)",
      "Bash(npm run services*)",
      "Bash(npx jest*)",
      "Bash(npx prettier*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(docker compose*)",
      "Bash(docker ps*)",
      "Bash(node infra/scripts/*)",
      "Bash(find . *)",
      "Bash(cat *)",
      "Bash(ls *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint:prettier:fix 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
